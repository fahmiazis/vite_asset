  "guideStockOpname": {
    "back": "返回",
    "title": "Stock Opname 使用指南",
    "subtitle": "使用 Stock Opname 所需了解的一切，从创建草稿到查看报告",
    "toc": "目录",
    "sections": {
      "overview": {
        "title": "Stock Opname 流程",
        "summary": "Stock opname 是对分支机构资产进行实物盘点，并与系统记录进行比对。流程如下：",
        "steps": [
          "草稿 — 所有资产自动加入，你填写盘点结果",
          "审批 — 按分支机构的审批流程等待审批",
          "执行 — 盘点结果被应用到资产数据",
          "完成 — 资产数据已更新，无法再修改"
        ],
        "tip": "在审批或执行阶段如有问题，可以驳回该盘点。"
      },
      "createDraft": {
        "title": "1. 创建新的 Stock Opname",
        "summary": "打开 Stock Opname 菜单，点击\"创建 Stock Opname\"。",
        "steps": [
          "盘点日期始终为当天 — 无法手动修改",
          "如需要可填写备注（可选），然后保存",
          "保存后，你所在分支的所有资产会自动加入列表 — 无需逐个添加"
        ],
        "tip": "如果分支的所有资产都已被另一个尚未完成的盘点占用，系统会拒绝创建并告知是哪个盘点在占用。请先完成或驳回那个盘点。"
      },
      "fillSingle": {
        "title": "2. 填写盘点结果 — 逐个填写",
        "summary": "适合只需更新少数资产的情况。",
        "steps": [
          "在详情页面找到要盘点的资产",
          "点击\"填写盘点结果\"（已填写过则显示\"编辑盘点结果\"）",
          "选择实物状态：存在 / 遗失",
          "选择状态 — 如果实物状态为\"遗失\"，状态会自动锁定为\"不适用\"",
          "如有变更填写资产状态，需要时填写备注",
          "点击\"保存结果\""
        ]
      },
      "fillGrid": {
        "title": "3. 填写盘点结果 — 完善数据（批量填写）",
        "summary": "适合连续盘点大量资产，无需反复打开关闭弹窗。",
        "steps": [
          "在详情页面点击\"完善数据\"",
          "打开类似 excel 的全屏表格 — 每行一个资产，可直接在单元格中编辑",
          "直接输入即可，无需每次点击保存 — 每 8 秒自动保存一次",
          "查看右上角的小图标了解保存状态（保存中.../已保存）",
          "不想等？点击\"立即保存\"",
          "资产太多？按 Ctrl+F（Mac 上是 Cmd+F）按名称或编号快速搜索"
        ],
        "tip": "保存失败的行（例如实物状态/状态组合无效）会显示一个小红点 — 悬停查看原因。"
      },
      "fillExcel": {
        "title": "4. 填写盘点结果 — 通过 Excel",
        "summary": "适合离线操作，或发给现场盘点的其他人员。",
        "steps": [
          "点击\"下载Excel模板\" — 获取包含此次盘点所有资产的excel文件",
          "填写实物状态、状态、资产状态、备注等列",
          "保存文件后，点击\"上传Excel结果\"并选择已填写的文件",
          "系统会处理每一行 — 有效的立即保存，无效的会告知具体行号和原因"
        ]
      },
      "submitApproval": {
        "title": "5. 提交与审批",
        "summary": "所有资产都填写了盘点结果后，就可以提交了。",
        "steps": [
          "在详情页面点击\"提交盘点\"",
          "盘点进入审批阶段，按分支机构的审批流程进行",
          "在\"审批状态\"中查看进度 — 了解谁需要审批以及哪些已完成/待处理"
        ],
        "tip": "如果还有资产的实物状态或状态未填写，提交会被拒绝。"
      },
      "execute": {
        "title": "6. 执行",
        "summary": "所有审批步骤完成后，盘点进入执行阶段。",
        "steps": [
          "有权限的角色（例如资产负责人）点击\"执行盘点\"",
          "系统将所有盘点结果应用到资产数据（状态、实物状态、资产状态）",
          "此后盘点状态变为\"已完成\"，数据无法再修改"
        ]
      },
      "reject": {
        "title": "7. 驳回",
        "summary": "如果审批或执行阶段出现问题，可以驳回该盘点。",
        "steps": [
          "在详情页面点击\"驳回\"",
          "填写驳回原因（必填，至少10个字符）",
          "已驳回的盘点无法继续 — 如仍需要，请创建新草稿"
        ]
      },
      "report": {
        "title": "8. 报表",
        "summary": "查看按周期和分支机构划分的盘点结果汇总。",
        "steps": [
          "打开 Stock Opname → 报表",
          "选择月份、年份和分支机构（或全部分支）",
          "在仪表盘查看摘要，或打开\"详情\"查看完整汇总表",
          "点击\"导出\"以excel格式下载报表"
        ]
      }
    }
  },
